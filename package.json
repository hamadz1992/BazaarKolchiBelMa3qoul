{
  "name": "bazaar-kolchi-belma3qoul",
  "private": true,
  "version": "0.2.9",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "node scripts/run-desktop.cjs",
    "desktop:dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && node scripts/run-desktop.cjs\"",
    "build": "vite build",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win",
    "api": "node server/index.mjs",
    "db:migrate": "node server/migrate.mjs",
    "mobile:serve": "node scripts/mobile-server.cjs",
    "electron:check": "node scripts/check-electron.cjs",
    "electron:repair": "node scripts/repair-electron.cjs",
    "db:check": "node server/db-check.mjs",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-postgres.ps1",
    "postinstall": "node scripts/repair-electron.cjs",
    "check": "node scripts/critical-hardening-check.cjs",
    "prebuild": "npm run check",
    "test": "node --test tests/**/*.test.mjs",
    "test:financial": "node --test tests/financial.integration.test.mjs",
    "audit:security": "node scripts/security-audit.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "pdf-to-printer": "^5.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5",
    "pg": "^8.16.3",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "43.2.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.belma3qoul.bazaar",
    "productName": "بزار كل شيء بالمعقول",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "server/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime/node-bin",
        "to": "node"
      }
    ],
    "asarUnpack": [
      "server/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "BazaarKolchiBelMa3qoul-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "hamadz1992",
      "repo": "BazaarKolchiBelMa3qoul",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@43.2.0": true
  }
}
