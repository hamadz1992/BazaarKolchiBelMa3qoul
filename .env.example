# PostgreSQL
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/BazaarKolchiBelMa3qoul
DB_POOL_MAX=10

# API
PORT=8787
# Comma-separated origins. For local Vite/Electron development:
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://appassets.androidplatform.net
SESSION_DAYS=30
# REQUIRED: 12+ chars, use at least 3 of lowercase/uppercase/digits/symbols
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_SECRET

# React/Vite -> Backend API
VITE_API_URL=http://localhost:8787/api

# Optional: cloud API base URL used by the mobile app when local LAN is unavailable
MOBILE_CLOUD_API_URL=https://YOUR-CLOUD-API.example.com/api
